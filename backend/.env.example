# NewsHub Backend 环境变量配置
# 复制此文件为 .env 并填写实际值

# ==================== 必填 ====================

# MongoDB 连接字符串
# 本地: mongodb://localhost:27017/news-brief
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/news-brief
MONGODB_URI=mongodb://localhost:27017/news-brief

# Redis 连接字符串（用于 WebSocket 实时推送）
# 本地: redis://localhost:6379
# Render/Upstash: redis://<user>:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# ==================== 可选 ====================

# 服务端口（默认 5000）
PORT=5000

# 前端地址（CORS 配置）
FRONTEND_URL=http://localhost:3000

# ==================== TTS 语音合成 ====================

# 火山引擎 TTS 配置（可选，不配置则 TTS 功能不可用）
# 获取方式: https://console.volcengine.com/speech/app
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_CLUSTER=volcano_tts
