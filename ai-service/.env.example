# NewsHub AI Service 环境变量配置
# 复制此文件为 .env 并填写实际值

# ==================== 必填 ====================

# MongoDB 连接字符串（与 backend 相同）
MONGODB_URI=mongodb://localhost:27017/news-brief

# Redis 连接字符串（用于发布新闻通知）
REDIS_URL=redis://localhost:6379

# AI Provider 选择: deepseek / openai / claude
AI_PROVIDER=deepseek

# DeepSeek API（推荐，便宜）
# 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API（备选）
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-3.5-turbo

# Claude API（备选）
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-3-haiku-20240307

# ==================== 可选 ====================

# 采集间隔（秒，默认 300 = 5分钟）
CRAWL_INTERVAL=300

# AI 并发线程数（默认 5）
AI_CONCURRENT_WORKERS=5

# 健康检查端口（Render 需要）
PORT=10000
